# Copy to .env privately; the application does not automatically load this file.
# Start an explicit environment file with: node --env-file=.env server/index.mjs
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=.local
# Local development may generate secrets in the private data directory.
# Production: set independent strong secrets through your secret manager.
# Each value must contain at least 32 random characters; generate them independently.
# BETTER_AUTH_SECRET=
# BOOTSTRAP_TOKEN=
# APP_URL is an origin only: no trailing slash, path, query, or fragment.
# Production requires a stable HTTPS APP_URL and persistent writable DATA_DIR.
# Material storage. Keep local during development; select oss after filling the
# private bucket configuration. Selecting oss never silently writes local files.
MEDIA_STORAGE=local
# MEDIA_STORAGE=oss
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_PREFIX=ad-growth-console
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
# Google reporting uses a private deployment-owned configuration file; credentials
# and file paths are never submitted through the website or committed to Git.
# GOOGLE_ADS_CONFIG_FILE=
# GOOGLE_ADS_API_VERSION=v25
# Optional existing HTTP(S) proxy for Google reporting only. Keep its URL private.
# GOOGLE_ADS_HTTPS_PROXY=
# Optional explicit installation team ID. Otherwise the first team owns this
# deployment's data connection; other teams cannot bind its allowed accounts.
# GOOGLE_ADS_TEAM_ID=
